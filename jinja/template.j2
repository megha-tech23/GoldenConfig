!

! Golden Config Intended Configuration

! Device: {{ obj.name }}

!


hostname {{ obj.name }}


{% if config_context.gc.ssh_source_interface is defined %}

ip ssh source-interface {{ config_context.gc.ssh_source_interface }}

{% endif %}


{% if config_context.gc.dns.servers is defined %}

ip name-server {% for dns in config_context.gc.dns.servers %}{{ dns }} {% endfor %}

{% endif %}


{% if config_context.gc.ntp.servers is defined %}

{% for ntp in config_context.gc.ntp.servers %}

ntp server {{ ntp }}

{% endfor %}

{% endif %}


{% if config_context.gc.logging_servers is defined %}

{% for server in config_context.gc.logging_servers %}

logging host {{ server }}

{% endfor %}

{% endif %}


end
